--- /dev/null
+++ b/src/autofan.cpp
@@
+#include "autofan.h"
+#include <Preferences.h>
+#include "sht30.h"
+#include "fancontrol.h"
+
+static Preferences prefs;
+AutoFan::AutoFan() {}
+
+void AutoFan::begin() { loadSettings(); }
+
+void AutoFan::loadSettings() {
+  prefs.begin("autofan", true);
+  settings.enabled = prefs.getBool("enabled", false);
+  settings.baseSpeed = prefs.getUChar("baseSpeed", 10);
+  settings.triggerHumidity = prefs.getUChar("triggerH", 77);
+  settings.speed1 = prefs.getUChar("speed1", 100);
+  settings.duration1 = prefs.getUShort("dur1", 10);
+  settings.speed2 = prefs.getUChar("speed2", 50);
+  settings.duration2 = prefs.getUShort("dur2", 30);
+  prefs.end();
+}
+
+void AutoFan::saveSettings() {
+  prefs.begin("autofan", false);
+  prefs.putBool("enabled", settings.enabled);
+  prefs.putUChar("baseSpeed", settings.baseSpeed);
+  prefs.putUChar("triggerH", settings.triggerHumidity);
+  prefs.putUChar("speed1", settings.speed1);
+  prefs.putUShort("dur1", settings.duration1);
+  prefs.putUChar("speed2", settings.speed2);
+  prefs.putUShort("dur2", settings.duration2);
+  prefs.end();
+}
+
+void AutoFan::loop() {
+  if (!settings.enabled) return;
+  float hum = SHT30_readHumidity(); // vervang door jouw sensorfunctie
+  if (isnan(hum)) return;
+
+  unsigned long now = millis();
+  if (state == 0) {
+    if (hum > settings.triggerHumidity) {
+      FanControl::setPercentage(settings.speed1);
+      state = 1;
+      stateStart = now;
+      return;
+    }
+    FanControl::setPercentage(settings.baseSpeed);
+    return;
+  }
+  if (state == 1) {
+    if (now - stateStart >= (unsigned long)settings.duration1 * 60UL * 1000UL) {
+      FanControl::setPercentage(settings.speed2);
+      state = 2;
+      stateStart = now;
+    }
+    return;
+  }
+  if (state == 2) {
+    if (now - stateStart >= (unsigned long)settings.duration2 * 60UL * 1000UL) {
+      FanControl::setPercentage(settings.baseSpeed);
+      state = 0;
+      stateStart = 0;
+    }
+    return;
+  }
+}
