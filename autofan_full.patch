+#pragma once
+#include <stdint.h>
+
+struct AutoFanSettings {
+  bool enabled = false;
+  uint8_t baseSpeed = 10;
+  uint8_t triggerHumidity = 77;
+  uint8_t speed1 = 100;
+  uint16_t duration1 = 10;
+  uint8_t speed2 = 50;
+  uint16_t duration2 = 30;
+};
+
+class AutoFan {
+public:
+  AutoFan();
+  void begin();
+  void loop();
+  void loadSettings();
+  void saveSettings();
+  AutoFanSettings settings;
+private:
+  int state = 0;
+  unsigned long stateStart = 0;
+};
diff --git a/src/autofan.cpp b/src/autofan.cpp
new file mode 100644
