+function saveAutoFan() {
+    const data = {
+        enabled: document.getElementById("afEnabled").checked,
+        baseSpeed: parseInt(document.getElementById("afBase").value),
+        triggerHumidity: parseInt(document.getElementById("afTrigger").value),
+        speed1: parseInt(document.getElementById("afSpeed1").value),
+        duration1: parseInt(document.getElementById("afDur1").value),
+        speed2: parseInt(document.getElementById("afSpeed2").value),
+        duration2: parseInt(document.getElementById("afDur2").value)
+    };
+    fetch("/api/autofan/set", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(data)
+    }).then(r => alert("Instellingen opgeslagen!"));
+}
